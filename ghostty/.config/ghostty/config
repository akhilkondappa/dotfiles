# By default Reload config with shft + cmd + ,
config-file = themes/rosepine
background-opacity = 0.85
background-blur-radius = 10

font-family = JetBrainsMonoNL Nerd Font
font-size = 16
font-feature = -liga,-calt,-dlig
cursor-style = block
cursor-style-blink = false
cursor-color = cell-foreground
cursor-text = cell-background
unfocused-split-opacity = 0.55
split-divider-color = #524f67

macos-titlebar-style = hidden
macos-option-as-alt = true
mouse-hide-while-typing = true

confirm-close-surface = false
window-decoration = auto
window-save-state = always
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

auto-update = check
auto-update-channel = stable

# extras
shell-integration-features = no-cursor
copy-on-select = clipboard
# cmd or alt c copy (not vim yank)

# Custom Keybinds & Config (super = cmd key on mac)
# For Simple Keybinds
keybind = ctrl+bracket_left=text:\x1b
keybind = super+i=inspector:toggle
keybind = ctrl+space>[=reload_config
keybind = super+shift+comma=reload_config

#-------------------------------------------

# Similar to Tmux Panes (no sessions)
# this only works if you have `macos-titlebar-style = tabs or native or transparent` else it behaves like new window
keybind = ctrl+space>c=new_tab
keybind = ctrl+space>n=new_window
keybind = ctrl+space>x=close_surface

# tab nav
keybind = ctrl+space>1=goto_tab:1
keybind = ctrl+space>2=goto_tab:2
keybind = ctrl+space>3=goto_tab:3
keybind = ctrl+space>4=goto_tab:4
keybind = ctrl+space>5=goto_tab:5
keybind = ctrl+space>6=goto_tab:6
keybind = ctrl+space>7=goto_tab:7
keybind = ctrl+space>8=goto_tab:8
keybind = ctrl+space>9=goto_tab:9

# splitting
keybind = ctrl+space>\=new_split:right
keybind = ctrl+space>-=new_split:down
keybind = ctrl+space>e=equalize_splits

# split nav (setting this to control will not work if tmux already uses it)
keybind = ctrl+space>h=goto_split:left
keybind = ctrl+space>j=goto_split:bottom
keybind = ctrl+space>k=goto_split:top
keybind = ctrl+space>l=goto_split:right

#Shaders
# custom-shader = shaders/bettercrt.glsl
# custom-shader = shaders/retro-terminal.glsl

#-------------------------------------------
# Tmux keybinds (mirrors wezterm workflow)
# \x01 = ctrl+a (tmux prefix)
#-------------------------------------------

# splits
keybind = super+backslash=text:\x01|
keybind = super+alt+backslash=text:\x01-

# pane: zoom / close
keybind = super+enter=text:\x01m
keybind = super+x=text:\x01x

# pane: navigate (vim-tmux-navigator uses ctrl+h/j/k/l directly without prefix)
keybind = super+alt+h=text:\x01h
keybind = super+alt+j=text:\x01j
keybind = super+alt+k=text:\x01k
keybind = super+alt+l=text:\x01l

# pane: swap
keybind = super+alt+s=text:\x01s

# windows (tabs)
keybind = super+t=text:\x01c
keybind = super+[=text:\x1bH
keybind = super+]=text:\x1bL
keybind = super+alt+x=text:\x01&

# window: move position
keybind = super+alt+[=text:\x01<
keybind = super+alt+]=text:\x01>

# window: jump by number (override both physical and translated key defaults)
keybind = super+1=text:\x011
keybind = super+digit_1=text:\x011
keybind = super+2=text:\x012
keybind = super+digit_2=text:\x012
keybind = super+3=text:\x013
keybind = super+digit_3=text:\x013
keybind = super+4=text:\x014
keybind = super+digit_4=text:\x014
keybind = super+5=text:\x015
keybind = super+digit_5=text:\x015
keybind = super+6=text:\x016
keybind = super+digit_6=text:\x016
keybind = super+7=text:\x017
keybind = super+digit_7=text:\x017
keybind = super+8=text:\x018
keybind = super+digit_8=text:\x018
keybind = super+9=text:\x019
keybind = super+digit_9=text:\x019

# scroll / search (enter copy-mode)
keybind = super+f=text:\x01/
keybind = super+u=text:\x01[

# new ghostty window
keybind = super+n=new_window

# session picker (sesh)
keybind = super+k=text:\x01K

# dock workspace orchestrator
keybind = alt+j=text:dock menu\x0d
keybind = alt+shift+j=text:\x01\x04
